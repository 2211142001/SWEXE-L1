<% if @book.errors.present? %>
  <h3>入力内容にエラーがあります</h3>
  <ul>
    <% @book.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @book do |f| %>
  <p>
    <%= f.label :title, 'タイトル' %>
    <%= f.text_field :title %>
  </p>
  <p>
    <%= f.label :author, '著者' %>
    <%= f.text_field :author %>
  </p>
  <p>
    <%= f.label :isbn, 'ISBN' %>
    <%= f.text_field :isbn %>
  </p>
    <%= f.submit '登録' %>
<% end %>
