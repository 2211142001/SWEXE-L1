<% if flash[:notice] %>
    <%= flash[:notice] %>
<% end %>

<% @books.each do |book| %>
  <div class="book-container">
    <p><strong>タイトル: </strong><%= book.title %></p>
    <p><strong>著者: </strong><%= book.author %></p>
    <p><strong>ISBN: </strong><%= book.isbn %></p>
    <%= link_to '表示', "/books/#{book.id}" %>
    <%= link_to '編集', "/books/#{book.id}/edit" %>
    <%= link_to '削除', "/books/#{book.id}", data: {turbo_method: :delete} %>
  </div>
<% end %>
<p><%= link_to '新規追加', '/books/new' %></p>

<style>
.book-container {
  border: 1px solid #ccc;
  padding: 10px;
  margin-bottom: 10px;
  border-radius: 6px;
}
</style>